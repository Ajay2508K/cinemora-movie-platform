// Copy this file to supabase-config.js and replace the values from Supabase and Cloudflare Turnstile.
// Only publishable/anon Supabase keys belong in browser code. Never put service_role or Turnstile secret keys here.
window.CINEMORA_CONFIG = {
  SUPABASE_URL: "https://YOUR-PROJECT-REF.supabase.co",
  SUPABASE_ANON_KEY: "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY",
  TURNSTILE_SITE_KEY: "YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY"
};
